# Optional local Compose configuration. Copy to ignored .env; never commit secrets.
# No environment file is required for default local startup.
SIGNALFORGE_BOOTSTRAP_ENABLED=false
SIGNALFORGE_BOOTSTRAP_EMAIL=
SIGNALFORGE_BOOTSTRAP_PASSWORD=
SIGNALFORGE_BOOTSTRAP_DISPLAY_NAME=Local Administrator

# Optional SMTP; supply real values locally only. Disabled by default.
SIGNALFORGE_MAIL_ENABLED=false
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLED=true
SIGNALFORGE_PUBLIC_URL=http://localhost:5173
