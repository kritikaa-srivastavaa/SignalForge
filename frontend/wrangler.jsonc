{
  "name": "signalforge",
  "main": "cloud-worker.js",
  "compatibility_date": "2026-09-18",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "preview_urls": false,
  "vars": {
    "BACKEND_ORIGIN": "https://signalforge-api-2uh8.onrender.com"
  }
}
