    {
      "id": 7,
      "title": "Incidents by Severity",
      "type": "timeseries",
      "description": "Rolling selected-range incident increases by severity. No series until an incident metric exists.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
