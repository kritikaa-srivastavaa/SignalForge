      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (severity) (increase(signalforge_incidents_created_total{job=\"signalforge\"}[$__range]))",
          "instant": false,
          "range": true,
          "legendFormat": "{{severity}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
